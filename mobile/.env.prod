# Production API (deployed AWS / custom domain)
# Applied by: npm run env:prod  →  writes mobile/.env.local
# Override URL: RYDO_PROD_API_URL=https://d123.cloudfront.net npm run env:prod

VITE_API_MODE=real
VITE_PLATFORM=native
VITE_API_BASE_URL=https://rydo.bike
VITE_APP_BASE_URL=https://rydo.bike

# Copied from client/.env.local by env:prod when missing
VITE_MAPBOX_ACCESS_TOKEN=
